      <bpmndi:BPMNEdge id="F30_di" bpmnElement="F30"><di:waypoint x="1890" y="1175"/><di:waypoint x="1960" y="1175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F31_di" bpmnElement="F31"><di:waypoint x="1996" y="1175"/><di:waypoint x="2050" y="1175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F34_di" bpmnElement="F34"><di:waypoint x="3490" y="1475"/><di:waypoint x="3520" y="1475"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F04_di" bpmnElement="F04"><di:waypoint x="455" y="135"/><di:waypoint x="455" y="90"/><di:waypoint x="3060" y="90"/><di:waypoint x="3060" y="120"/></bpmndi:BPMNEdge>
