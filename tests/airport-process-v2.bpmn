<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_Airport_v2"
  targetNamespace="http://omniboard.local/airport">

  <bpmn:collaboration id="Collab_Airport">
    <bpmn:participant id="Pool_Airline" name="HÀNG HÀNG KHÔNG" processRef="Process_Airline"/>
    <bpmn:textAnnotation id="Ann_Rule">
      <bpmn:text>QUY ĐỊNH KIỂM TRA HÀNG HÓA</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>

  <bpmn:process id="Process_Airline" name="QUY TRÌNH ĐI MÁY BAY (v2 gần bản mẫu)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_KyGui" name="Nhân viên ký gửi">
        <bpmn:flowNodeRef>Start_CargoReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCargo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CargoRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveHandle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnCargo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CheckIn" name="Nhân viên Check In">
        <bpmn:flowNodeRef>Task_CheckDoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DocRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnDoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PaxType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Transit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Customs" name="Nhân viên hải quan">
        <bpmn:flowNodeRef>Task_CheckVisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_VisaValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StampVisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Immigration</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="Nhân viên an ninh">
        <bpmn:flowNodeRef>Task_SecurityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SecurityRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitingRoom</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ground" name="Bộ phận mặt đất">
        <bpmn:flowNodeRef>Task_MoveImmigration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Baggage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MoveBagClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MoveArrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MoveBoardingGate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CabinCrew" name="Tiếp viên hàng không">
        <bpmn:flowNodeRef>Task_CheckBoardingPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuideBoarding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_FlightTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuideToPlane</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LostFound" name="Bộ phận Lost and Found">
        <bpmn:flowNodeRef>Task_LostFoundHandle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_CargoReq" name="Yêu cầu ký gửi hàng hóa"/>
    <bpmn:task id="Task_CheckCargo" name="Kiểm tra hàng hóa và làm thủ tục"/>
    <bpmn:exclusiveGateway id="Gw_CargoRule" name="Đúng quy định?"/>
    <bpmn:task id="Task_ReceiveHandle" name="Nhận hàng và xử lý"/>

    <bpmn:task id="Task_CheckDoc" name="Kiểm tra vé và các giấy tờ liên quan"/>
    <bpmn:exclusiveGateway id="Gw_DocRule" name="Đúng quy định?"/>
    <bpmn:task id="Task_ReturnDoc" name="Trả vé và các giấy tờ liên quan"/>

    <bpmn:exclusiveGateway id="Gw_PaxType" name="Loại hành khách"/>
    <bpmn:task id="Task_Transit" name="Làm thủ tục transit"/>
    <bpmn:task id="Task_CheckVisa" name="Kiểm tra Visa"/>
    <bpmn:exclusiveGateway id="Gw_VisaValid" name="Visa còn hạn?"/>
    <bpmn:task id="Task_StampVisa" name="Đóng dấu và gửi lại Visa"/>
    <bpmn:task id="Task_Immigration" name="Làm thủ tục nhập cảnh"/>

    <bpmn:task id="Task_SecurityCheck" name="Kiểm tra hành lý và an ninh"/>
    <bpmn:exclusiveGateway id="Gw_SecurityRule" name="Đúng quy định?"/>
    <bpmn:task id="Task_WaitingRoom" name="Đưa hành khách vào phòng đợi"/>

    <bpmn:task id="Task_MoveImmigration" name="Di chuyển HK qua khu vực nhập cảnh"/>
    <bpmn:exclusiveGateway id="Gw_Baggage" name="Có ký gửi hành hóa?"/>
    <bpmn:task id="Task_MoveBagClaim" name="Di chuyển HK qua khu vực xử lý đồ"/>
    <bpmn:task id="Task_MoveArrival" name="Di chuyển HK qua khu vực Arrival"/>
    <bpmn:task id="Task_MoveBoardingGate" name="Di chuyển hành khách xuống máy bay"/>

    <bpmn:task id="Task_CheckBoardingPass" name="Kiểm tra Boarding Pass"/>
    <bpmn:task id="Task_GuideBoarding" name="Hướng dẫn hành khách lên máy bay"/>
    <bpmn:intermediateCatchEvent id="Ev_FlightTime" name="Thời gian bay">
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_GuideToPlane" name="Hướng dẫn hành khách xuống máy bay"/>

    <bpmn:task id="Task_ReturnCargo" name="Trả hàng hóa"/>
    <bpmn:task id="Task_LostFoundHandle" name="Xử lý"/>
    <bpmn:endEvent id="End_Done" name="Kết thúc"/>

    <bpmn:sequenceFlow id="F01" sourceRef="Start_CargoReq" targetRef="Task_CheckCargo"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_CheckCargo" targetRef="Gw_CargoRule"/>
    <bpmn:sequenceFlow id="F03" sourceRef="Gw_CargoRule" targetRef="Task_ReceiveHandle" name="Đúng quy định"/>
    <bpmn:sequenceFlow id="F04" sourceRef="Gw_CargoRule" targetRef="Task_ReturnCargo" name="Sai quy định"/>
    <bpmn:sequenceFlow id="F05" sourceRef="Task_ReceiveHandle" targetRef="Task_CheckDoc"/>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_CheckDoc" targetRef="Gw_DocRule"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Gw_DocRule" targetRef="Task_ReturnDoc" name="Đúng quy định"/>
    <bpmn:sequenceFlow id="F08" sourceRef="Gw_DocRule" targetRef="Task_ReturnCargo" name="Sai quy định"/>
    <bpmn:sequenceFlow id="F09" sourceRef="Task_ReturnDoc" targetRef="Gw_PaxType"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_PaxType" targetRef="Task_Transit" name="Hành khách đi quốc tế có transit"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_PaxType" targetRef="Task_CheckVisa" name="Hành khách đi quốc tế không transit"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_PaxType" targetRef="Task_SecurityCheck" name="Hành khách đi nội địa"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Transit" targetRef="Task_Immigration"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_CheckVisa" targetRef="Gw_VisaValid"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_VisaValid" targetRef="Task_StampVisa" name="Visa còn hạn"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_VisaValid" targetRef="Task_ReturnCargo" name="Visa hết hạn"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_StampVisa" targetRef="Task_SecurityCheck"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Immigration" targetRef="Task_MoveImmigration"/>
    <bpmn:sequenceFlow id="F19" sourceRef="Task_SecurityCheck" targetRef="Gw_SecurityRule"/>
    <bpmn:sequenceFlow id="F20" sourceRef="Gw_SecurityRule" targetRef="Task_WaitingRoom" name="Đúng quy định"/>
    <bpmn:sequenceFlow id="F21" sourceRef="Gw_SecurityRule" targetRef="Task_ReturnCargo" name="Sai quy định"/>
    <bpmn:sequenceFlow id="F22" sourceRef="Task_MoveImmigration" targetRef="Gw_Baggage"/>
    <bpmn:sequenceFlow id="F23" sourceRef="Gw_Baggage" targetRef="Task_MoveBagClaim" name="Có ký gửi hàng hóa"/>
    <bpmn:sequenceFlow id="F24" sourceRef="Gw_Baggage" targetRef="Task_MoveArrival" name="Không ký gửi hàng hóa"/>
    <bpmn:sequenceFlow id="F25" sourceRef="Task_MoveBagClaim" targetRef="Task_MoveBoardingGate"/>
    <bpmn:sequenceFlow id="F26" sourceRef="Task_MoveArrival" targetRef="Task_MoveBoardingGate"/>
    <bpmn:sequenceFlow id="F27" sourceRef="Task_WaitingRoom" targetRef="Task_CheckBoardingPass"/>
    <bpmn:sequenceFlow id="F28" sourceRef="Task_MoveBoardingGate" targetRef="Task_CheckBoardingPass"/>
    <bpmn:sequenceFlow id="F29" sourceRef="Task_CheckBoardingPass" targetRef="Task_GuideBoarding"/>
    <bpmn:sequenceFlow id="F30" sourceRef="Task_GuideBoarding" targetRef="Ev_FlightTime"/>
    <bpmn:sequenceFlow id="F31" sourceRef="Ev_FlightTime" targetRef="Task_GuideToPlane"/>
    <bpmn:sequenceFlow id="F32" sourceRef="Task_GuideToPlane" targetRef="Task_LostFoundHandle"/>
    <bpmn:sequenceFlow id="F33" sourceRef="Task_ReturnCargo" targetRef="Task_LostFoundHandle"/>
    <bpmn:sequenceFlow id="F34" sourceRef="Task_LostFoundHandle" targetRef="End_Done"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Airport_v2">
    <bpmndi:BPMNPlane id="Plane_Airport_v2" bpmnElement="Collab_Airport">
      <bpmndi:BPMNShape id="Pool_Airline_di" bpmnElement="Pool_Airline" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="3600" height="1650"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_KyGui_di" bpmnElement="Lane_KyGui" isHorizontal="true"><dc:Bounds x="80" y="40" width="3560" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CheckIn_di" bpmnElement="Lane_CheckIn" isHorizontal="true"><dc:Bounds x="80" y="260" width="3560" height="230"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Customs_di" bpmnElement="Lane_Customs" isHorizontal="true"><dc:Bounds x="80" y="490" width="3560" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Security_di" bpmnElement="Lane_Security" isHorizontal="true"><dc:Bounds x="80" y="690" width="3560" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ground_di" bpmnElement="Lane_Ground" isHorizontal="true"><dc:Bounds x="80" y="860" width="3560" height="230"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CabinCrew_di" bpmnElement="Lane_CabinCrew" isHorizontal="true"><dc:Bounds x="80" y="1090" width="3560" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_LostFound_di" bpmnElement="Lane_LostFound" isHorizontal="true"><dc:Bounds x="80" y="1310" width="3560" height="380"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_CargoReq_di" bpmnElement="Start_CargoReq"><dc:Bounds x="130" y="145" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckCargo_di" bpmnElement="Task_CheckCargo"><dc:Bounds x="220" y="120" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_CargoRule_di" bpmnElement="Gw_CargoRule"><dc:Bounds x="430" y="135" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceiveHandle_di" bpmnElement="Task_ReceiveHandle"><dc:Bounds x="540" y="120" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnCargo_di" bpmnElement="Task_ReturnCargo"><dc:Bounds x="2990" y="120" width="140" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckDoc_di" bpmnElement="Task_CheckDoc"><dc:Bounds x="780" y="320" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_DocRule_di" bpmnElement="Gw_DocRule"><dc:Bounds x="1010" y="335" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnDoc_di" bpmnElement="Task_ReturnDoc"><dc:Bounds x="1120" y="320" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_PaxType_di" bpmnElement="Gw_PaxType"><dc:Bounds x="1350" y="335" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Transit_di" bpmnElement="Task_Transit"><dc:Bounds x="1460" y="280" width="140" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckVisa_di" bpmnElement="Task_CheckVisa"><dc:Bounds x="1460" y="540" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_VisaValid_di" bpmnElement="Gw_VisaValid"><dc:Bounds x="1660" y="550" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StampVisa_di" bpmnElement="Task_StampVisa"><dc:Bounds x="1770" y="540" width="160" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Immigration_di" bpmnElement="Task_Immigration"><dc:Bounds x="2060" y="540" width="160" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SecurityCheck_di" bpmnElement="Task_SecurityCheck"><dc:Bounds x="1460" y="740" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_SecurityRule_di" bpmnElement="Gw_SecurityRule"><dc:Bounds x="1680" y="755" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WaitingRoom_di" bpmnElement="Task_WaitingRoom"><dc:Bounds x="1790" y="740" width="170" height="80"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MoveImmigration_di" bpmnElement="Task_MoveImmigration"><dc:Bounds x="2310" y="900" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Baggage_di" bpmnElement="Gw_Baggage"><dc:Bounds x="2530" y="910" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MoveBagClaim_di" bpmnElement="Task_MoveBagClaim"><dc:Bounds x="2630" y="870" width="170" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MoveArrival_di" bpmnElement="Task_MoveArrival"><dc:Bounds x="2630" y="960" width="170" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MoveBoardingGate_di" bpmnElement="Task_MoveBoardingGate"><dc:Bounds x="2850" y="915" width="190" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckBoardingPass_di" bpmnElement="Task_CheckBoardingPass"><dc:Bounds x="1460" y="1140" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GuideBoarding_di" bpmnElement="Task_GuideBoarding"><dc:Bounds x="1710" y="1140" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ev_FlightTime_di" bpmnElement="Ev_FlightTime"><dc:Bounds x="1960" y="1157" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GuideToPlane_di" bpmnElement="Task_GuideToPlane"><dc:Bounds x="2050" y="1140" width="190" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_LostFoundHandle_di" bpmnElement="Task_LostFoundHandle"><dc:Bounds x="3360" y="1440" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done"><dc:Bounds x="3520" y="1457" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Ann_Rule_di" bpmnElement="Ann_Rule"><dc:Bounds x="600" y="70" width="330" height="90"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F01_di" bpmnElement="F01"><di:waypoint x="166" y="163"/><di:waypoint x="220" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F02_di" bpmnElement="F02"><di:waypoint x="380" y="160"/><di:waypoint x="430" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F03_di" bpmnElement="F03"><di:waypoint x="480" y="160"/><di:waypoint x="540" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F05_di" bpmnElement="F05"><di:waypoint x="700" y="160"/><di:waypoint x="780" y="360"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F06_di" bpmnElement="F06"><di:waypoint x="950" y="360"/><di:waypoint x="1010" y="360"/></bpmndi:BPMNEdge>
